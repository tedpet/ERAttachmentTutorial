WrapperComponent: Wrapper {
}

FirstName: WOString {
    value = aPerson.firstName;
}

LastName: WOString {
    value = aPerson.lastName;
}

PhotoViewer: ERAttachmentViewer {
    configurationName = "Person.photo";
    attachment = aPerson.thebigphoto;
}

ReturnLink: WOHyperlink {
    action = toMain;
}